#!/bin/bash
# Runs once, on the node's first boot: swap, then a single-node K3s
set -euo pipefail

# 1 GB of RAM: swap keeps K3s and the pods from being OOM-killed at startup
fallocate -l 2G /swapfile
chmod 600 /swapfile
mkswap /swapfile
swapon /swapfile
echo '/swapfile none swap sw 0 0' >> /etc/fstab

# Traefik stays on as the ingress; metrics-server is not needed without autoscaling
curl -sfL https://get.k3s.io | INSTALL_K3S_VERSION="${k3s_version}" sh -s - server \
  --disable metrics-server \
  --write-kubeconfig-mode 0600
